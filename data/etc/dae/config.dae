global {
  # Bind to LAN and/or WAN as you want. Replace the interface name to your own.
  lan_interface: waydroid0, et, tailscale0, vmnet8
  wan_interface: auto # Use "auto" to auto detect WAN interface.

  # tproxy_port: 12345
  # tproxy_port_protect: true

  log_level: warn
  allow_insecure: false
  auto_config_kernel_parameter: true

  # mptcp: true
}

subscription {
  # Fill in your subscription links here.
  sub: 'file://sub.d/sub.sub'
}

# See https://github.com/daeuniverse/dae/blob/main/docs/en/configuration/dns.md for full examples.
dns {
  # For example, if ipversion_prefer is 4 and the domain name has both type A and type AAAA records, the dae will only
  # respond to type A queries and response empty answer to type AAAA queries.
  #ipversion_prefer: 4
  
  upstream {
    alidns: 'udp://dns.alidns.com:53'
    alidns_doh: 'https://dns.alidns.com/dns-query'
    alidns_dot: 'tls://dns.alidns.com:853'
    alidns_doq: 'quic://dns.alidns.com:853'
    cfdns: 'tcp+udp://cloudflare-dns.com:53'
    cfdns_doh: 'https://cloudflare-dns.com/dns-query'
    cfdns_dot: 'tls://1.1.1.1:853'
    googledns: 'tcp+udp://dns.google:53'
    googledns_doh: 'https://dns.google/dns-query'
    googledns_dot: 'tls://dns.google:853'
    quad9: 'tcp+udp://9.9.9.9:53'
  }
  routing {
    request {
      # Block AD
      qname(geosite:category-ads-all) -> reject

      qtype(https) -> reject

      qname(geosite:cn) -> alidns_dot
      fallback: cfdns_dot
    }
  }
}

group {
  proxy {
    filter: subtag(sub) && name(regex: 'UK|英国|伦敦|US|美国|纽约')
    policy: min_moving_avg
    # policy: fixed(1)
  }

  proxy_unlimit {
    filter: subtag(sub) && name(regex: 'UK|英国|伦敦|US|美国|纽约')
    policy: min_moving_avg
  }

  proxy_ru {
    filter: subtag(sub) && name(regex: 'RU|俄罗斯')
    policy: min_moving_avg
  }
}

# See https://github.com/daeuniverse/dae/blob/main/docs/en/configuration/routing.md for full examples.
routing {
  ## === Level 1 === (No proxy and block)

  pname(NetworkManager, systemd-resolved, dnsmasq) -> direct
  pname(tailscaled, zerotier-one, easytier-core) -> must_direct
  pname(uuplugin) -> must_direct
  dip(224.0.0.0/3, 'ff00::/8') -> direct
  dip(geoip:private, 192.168.122.57) -> direct

  ## Block
  domain(geosite:category-ads-all) -> block

  ## Disable h3 because it usually consumes too much cpu/mem resources.
  #l4proto(udp) && dport(443) -> block

  ## By glider
  # pname(zen-bin) -> direct

  ## === Level 2 === (Ensure that by proxy)

  domain(openrouter.ai) -> proxy_unlimit
  domain(chatgpt.com) -> proxy_unlimit
  domain(geosite:google) -> proxy_unlimit
  domain(regex:rambler.ru$) -> proxy_ru
  pname(tor, Telegram) -> proxy
  pname(code) -> proxy

  ## === Level 3 === (Direct)

  ## Amytele
  dip(161.129.35.81) -> direct

  pname(ssh, adb) -> direct
  ## 目标非常用端口都走直连，避免BT流量和游戏走代理
  #!dport(21,22,23,53,80,123,143,194,443,465,587,853,993,995,998) -> direct
  ## ArchLinux
  #domain(ping.archlinux.org) -> direct
  #domain(aur.archlinux.org) -> direct
  ## Games
  #domain(geosite:category-games) -> direct
  ## Steam
  domain(
    steamserver.net,
    steamcontent.com,
    api.steampowered.com,
    regex:.cm.steampowered.com$,
    regex:.steamserver.net$,
    regex:cache.*.steamcontent.com$
  ) -> direct

  ## CN
  dip(geoip:cn) -> direct
  domain(geosite:cn) -> direct

  fallback: proxy
}
